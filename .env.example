OPENAI_API_KEY=example-openai-api-key

# GITHUB_TOKEN=example-github-token

# RAGPI_API_KEY=example-api-key

# --- Reasoning models (OpenAI Responses API, opt-in; requires CHAT_PROVIDER=openai) ---
# DEFAULT_CHAT_MODEL=gpt-5.6-sol
# CHAT_USE_RESPONSES_API=true
# REASONING_EFFORT=medium   # gpt-5.6: none|low|medium|high|xhigh|max (minimal is for older gpt-5 models)
# store=true is sent (conversation state retained by OpenAI); ZDR is not yet supported.
# OPENAI_RESPONSES_STORE=true

# --- Embeddings ---
# text-embedding-3-large at full 3072 dims (Postgres needs pgvector server ext >= 0.8.2;
# the pgvector/pgvector:pg17 image satisfies it). Changing the model/dims requires
# recreating the store and re-embedding — see the README.
# EMBEDDING_MODEL=text-embedding-3-large
# EMBEDDING_DIMENSIONS=3072
# EMBEDDING_CANDIDATE_MULTIPLIER=10   # >2000-dim over-fetch before float32 rerank
# HNSW_EF_SEARCH=                     # optional; derived from candidate count when unset
# EMBEDDING_SPACE_ID=                 # optional endpoint-space id for ollama/openai-compatible
# EMBEDDING_ADOPT_EXISTING=false      # adopt an unmarked non-default legacy store
# PG_UPDATE_VECTOR_EXTENSION=false    # run ALTER EXTENSION vector UPDATE at startup (whole DB)
